<Window x:Class="MineIDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MineIDE"
        xmlns:vm="clr-namespace:MineIDE.ViewModels"
        xmlns:models="clr-namespace:MineIDE.Models"
        xmlns:ctrl="clr-namespace:MineIDE.Controls"
        xmlns:recipe="clr-namespace:MineIDE.RecipeEditor"
        xmlns:adv="clr-namespace:MineIDE.AdvancementEditor"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Mine IDE" Height="900" Width="1440" MinHeight="640" MinWidth="1100"
        Icon="/iconca.png"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgbgBrush}"
        Foreground="{DynamicResource ForegroundBrush}"
        FontFamily="{DynamicResource UiFontFamily}"
        FontSize="{DynamicResource UiFontSize}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Resource brushes for animation purposes -->
        <SolidColorBrush x:Key="HoverHighlightBrush" Color="#33FFFFFF"/>

        <!-- Item icon resolver (from the RecipeEditor module) -->
        <recipe:ItemIconConverter x:Key="ItemIcon"/>

        <!-- Side panel header label -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="Margin" Value="20,18,0,8"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgbgLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="ActivityBtn" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent">
                            <Grid>
                                <Border x:Name="Indicator" Width="2" HorizontalAlignment="Left" Background="{DynamicResource ForegroundBrush}" Opacity="0"/>
                                <ContentPresenter x:Name="IconText"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                                <Setter TargetName="IconText" Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                                <Setter TargetName="IconText" Property="TextElement.Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding Tag, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="400"/>
        </Style>

        <!-- Custom list item for Activity Bar selection -->
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top bar -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/> <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ============== TOP BAR (menu + toolbar) ============== -->
        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <!-- Menu bar (VS Code style) -->
                <Menu Grid.Row="0" Margin="8,1,0,1" Background="Transparent"
                      Foreground="{DynamicResource ForegroundBrush}" FontSize="11">
                    <MenuItem Header="Файл" Padding="7,2">
                        <MenuItem Header="Новый файл" Click="OnMenuNewFileClick"/>
                        <MenuItem Header="Открыть проект…" Click="OnOpenProjectClick"/>
                        <MenuItem Header="Открыть проект (.mmcp)…" Click="OnMenuOpenMmcpClick"/>
                        <Separator/>
                        <MenuItem Header="Сохранить (Ctrl+S)" Click="OnMenuSaveClick"/>
                        <MenuItem Header="Сохранить проект (.mmcp)…" Click="OnMenuSaveMmcpClick"/>
                        <Separator/>
                        <MenuItem Header="Выход" Click="OnMenuExitClick"/>
                    </MenuItem>
                    <MenuItem Header="Вид" Padding="7,2">
                        <MenuItem Header="Сменить тему" Click="OnToggleThemeClick"/>
                        <MenuItem Header="Терминал (Ctrl+`)" Click="OnToggleTerminal"/>
                        <MenuItem Header="Explorer (Ctrl+Shift+E)" Click="OnMenuExplorerClick"/>
                        <Separator/>
                        <MenuItem Header="Редактор рецептов" Click="OnOpenRecipeEditorClick"/>
                        <MenuItem Header="Конструктор достижений" Click="OnOpenAdvancementEditorClick"/>
                        <MenuItem Header="Редактор моделей (Blockbench)" Click="OnOpenModelEditorClick"/>
                        <MenuItem Header="Быстрый доступ" Click="OnOpenQuickAccessClick"/>
                    </MenuItem>
                    <MenuItem Header="Импорт" Padding="7,2">
                        <MenuItem Header="Импортировать предмет (id)…" Click="OnImportItemClick"/>
                        <MenuItem Header="Импортировать модель (JSON)…" Click="OnImportModelClick"/>
                    </MenuItem>
                </Menu>

                <Grid Grid.Row="1" Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App logo (icon of the application itself) -->
                    <Border Width="28" Height="28" CornerRadius="5" Margin="0,0,12,0"
                            Background="{DynamicResource BgbgLightBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                        <Image Source="/iconca.png" Width="20" Height="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Project selector -->
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject}"
                              DisplayMemberPath="DisplayLabel"
                              MinWidth="280" Margin="0,0,4,0" ToolTip="Проект"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Открыть Forge-проект (папку с build.gradle)"
                            Click="OnOpenProjectClick" Width="26" Height="24" Margin="0,0,8,0">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>

                    <!-- MC version -->
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding McVersions}"
                              SelectedItem="{Binding SelectedProject.MinecraftVersion}"
                              MinWidth="100" Margin="0,0,4,0" ToolTip="Версия Minecraft">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⛏ " Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Forge version (auto-updates when MC version changes) -->
                    <ComboBox Style="{StaticResource ModernComboBox}"
                              ItemsSource="{Binding ForgeVersions}"
                              SelectedItem="{Binding SelectedProject.ForgeVersion}"
                              MinWidth="100" Margin="0,0,8,0" ToolTip="Версия Forge"/>

                    <!-- Separator -->
                    <Border Width="1" Background="{DynamicResource BorderLightBrush}" Margin="4,6"/>

                    <!-- Build / Run -->
                    <Button Style="{StaticResource FlatButton}" Click="OnBuildClick"
                            ToolTip="Собрать проект (Ctrl+Shift+B)" Margin="2,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource MinecraftGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Build" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Click="OnRunClick"
                            ToolTip="Собрать и запустить (F5)" Margin="2,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Run" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="OnStopClick"
                            IsEnabled="{Binding IsLauncherRunning}"
                            ToolTip="Остановить Minecraft" Margin="2,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource ErrorBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Stop" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Activity / Debug / Profile -->
                    <ComboBox Style="{StaticResource ModernComboBox}" MinWidth="120" Margin="0,0,4,0" ToolTip="Профиль запуска (gradle-задача)"
                              ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"/>
                    <Button Style="{StaticResource FlatButton}" Click="OnOpenRecipeEditorClick"
                            ToolTip="Редактор рецептов (визуальное создание JSON)" Margin="2,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Stroke="{DynamicResource ForegroundMutedBrush}" StrokeThickness="1.1"
                                          Data="M1.5,1.5 H14.5 V14.5 H1.5 Z M5.83,1.5 V14.5 M10.17,1.5 V14.5 M1.5,5.83 H14.5 M1.5,10.17 H14.5"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Рецепты" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Click="OnOpenModelEditorClick"
                            ToolTip="Редактор моделей (Blockbench)" Margin="2,0" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path Fill="{DynamicResource ForegroundMutedBrush}" Opacity="1.0"
                                          Data="M3,2.5 L8,0.5 L13,2.5 L8,4.5 Z"/>
                                    <Path Fill="{DynamicResource ForegroundMutedBrush}" Opacity="0.7"
                                          Data="M3,2.5 L8,4.5 L8,13.5 L3,11.5 Z"/>
                                    <Path Fill="{DynamicResource ForegroundMutedBrush}" Opacity="0.45"
                                          Data="M13,2.5 L8,4.5 L8,13.5 L13,11.5 Z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Модели" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Профиль производительности">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Расширения">
                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Сменить тему"
                            Click="OnToggleThemeClick" Width="24" Height="20" FontSize="11" Margin="0,0,2,0">
                        <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="Настройки" Click="OnSettingsClick">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============== MAIN AREA ============== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Activity bar -->
                <ColumnDefinition x:Name="SidePanelColumn" Width="280" MinWidth="160"/> <!-- Side panel (тянуть за край) -->
                <ColumnDefinition Width="Auto"/> <!-- Splitter -->
                <ColumnDefinition Width="*"/>    <!-- Editor -->
            </Grid.ColumnDefinitions>

            <!-- Activity Bar (left vertical icons) -->
            <Border Grid.Column="0" Width="48" Background="{DynamicResource ActivityBarBrush}">
                <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                    <ToggleButton x:Name="AB_Explorer" Style="{StaticResource ActivityBtn}" Tag="Explorer (Ctrl+Shift+E)" IsChecked="True" Click="OnActivityClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol" FontSize="16">
                        <TextBlock Text="&#xE8B7;"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AB_Mods" Style="{StaticResource ActivityBtn}" Tag="Mods" Click="OnActivityClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol" FontSize="16">
                        <TextBlock Text="&#xE8A5;"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AB_Data" Style="{StaticResource ActivityBtn}" Tag="Data Packs" Click="OnActivityClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol" FontSize="16">
                        <TextBlock Text="&#xE71D;"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AB_Advancements" Style="{StaticResource ActivityBtn}" Tag="Advancements" Click="OnActivityClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol" FontSize="16">
                        <TextBlock Text="&#xE7C1;"/>
                    </ToggleButton>
                    <ToggleButton x:Name="AB_Performance" Style="{StaticResource ActivityBtn}" Tag="Performance" Click="OnActivityClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol" FontSize="16">
                        <TextBlock Text="&#xE9D9;"/>
                    </ToggleButton>
                    <Separator Margin="10,8" Background="{DynamicResource BorderLightBrush}"/>
                    <ToggleButton x:Name="AB_Extensions" Style="{StaticResource ActivityBtn}" Tag="Extensions" Click="OnActivityClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol" FontSize="16">
                        <TextBlock Text="&#xE74C;"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- Side Panel (changes with active activity) -->
            <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- Explorer -->
                    <Grid x:Name="PN_Explorer" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="20,12,8,4">
                            <TextBlock Text="EXPLORER" Style="{StaticResource SectionHeader}" Margin="0"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" Margin="6,0,0,0" Width="22" Height="22" FontSize="11"
                                    ToolTip="Открыть проект" Click="OnOpenExplorerClick">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <Button x:Name="CreateProjectBtn" Style="{StaticResource IconButton}" Margin="0" Width="22" Height="22" FontSize="11"
                                    ToolTip="Создать проект (мод / датапак)"
                                    MouseEnter="OnCreateMenuOpen" MouseLeave="OnCreateMenuClose">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <Popup x:Name="CreateMenuPopup" PlacementTarget="{Binding ElementName=CreateProjectBtn}"
                                   Placement="Bottom" AllowsTransparency="True" StaysOpen="False" IsOpen="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="4" Margin="0,4,0,0" MinWidth="170" Padding="3"
                                        MouseEnter="OnCreateMenuPopupEnter" MouseLeave="OnCreateMenuPopupLeave">
                                    <StackPanel>
                                        <Button Style="{StaticResource FlatButton}" Click="OnCreateModClick"
                                                HorizontalContentAlignment="Left" Padding="8,4" Margin="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Создать мод (Forge)" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource FlatButton}" Click="OnCreateDatapackClick"
                                                HorizontalContentAlignment="Left" Padding="8,4" Margin="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Создать датапак" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Popup>
                            <Button Style="{StaticResource IconButton}" Margin="0" Width="22" Height="22" FontSize="11"
                                    ToolTip="Обновить" Click="OnRefreshExplorerClick">
                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="0" Width="22" Height="22" FontSize="11"
                                    ToolTip="Свернуть">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                        <TreeView Grid.Row="1" Style="{StaticResource ModernTreeView}"
                                  ItemsSource="{Binding ExplorerRoots}"
                                  BorderThickness="0" Padding="4,0">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Display}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <EventSetter Event="MouseDoubleClick" Handler="OnTreeDoubleClick"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>

                    <!-- Mods -->
                    <Grid x:Name="PN_Mods" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MODS" Style="{StaticResource SectionHeader}" Margin="20,12,0,0"/>
                            <Button Style="{StaticResource IconButton}" ToolTip="Выбрать папку с модом"
                                    Click="OnChooseModFolderClick" Width="22" Height="22" FontSize="11"
                                    Margin="8,14,0,0">
                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Папка runs/mods пуста. Соберите проект — сюда попадут .jar."
                                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="14,4"
                                   Visibility="{Binding Mods.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="8,0" MaxHeight="220"
                                 ItemsSource="{Binding Mods}"
                                 Visibility="{Binding Mods.Count, Converter={StaticResource CountToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource MinecraftGreenBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Fill" Value="{DynamicResource ForegroundDimBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="{Binding ToggleLabel}" Style="{StaticResource FlatButton}" FontSize="11" Padding="8,1" Margin="8,0,0,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Click="OnToggleModClick"/>
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="11"
                                                Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Удалить мод (файл .jar)"
                                                Click="OnDeleteModClick">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Selected mod folder (idea 2): pick any folder and browse its files -->
                        <Border Grid.Row="2" Height="1" Background="{DynamicResource BorderLightBrush}" Margin="14,8"/>
                        <TextBlock Grid.Row="3" Text="ПАПКА МОДА" Style="{StaticResource SectionHeader}" Margin="20,8,0,2"/>
                        <TextBlock Grid.Row="4" Text="{Binding ModFolderPath, TargetNullValue='Не выбрана — нажмите кнопку 📁 выше'}"
                                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="14,0,8,4"/>
                        <TreeView Grid.Row="5" Style="{StaticResource ModernTreeView}"
                                  ItemsSource="{Binding ModFolderFiles}"
                                  BorderThickness="0" Padding="4,0"
                                  Visibility="{Binding ModFolderPath, Converter={StaticResource NullToVis}}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding Display}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <EventSetter Event="MouseDoubleClick" Handler="OnTreeDoubleClick"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </Grid>

                    <!-- Data Packs -->
                    <Grid x:Name="PN_Data" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="DATA PACKS" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Grid.Row="1" Text="Датапаки в runs/saves/*/datapacks. Появятся после первого запуска мира."
                                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="14,4"
                                   Visibility="{Binding DataPacks.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}"/>
                        <ListBox Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="8,0"
                                 ItemsSource="{Binding DataPacks}"
                                 Visibility="{Binding DataPacks.Count, Converter={StaticResource CountToVis}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="📦 " Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Advancements -->
                    <Grid x:Name="PN_Advancements" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ДОСТИЖЕНИЯ" Style="{StaticResource SectionHeader}" Margin="20,12,0,0"/>
                            <Button Style="{StaticResource IconButton}" ToolTip="Открыть конструктор достижений"
                                    Click="OnOpenAdvancementEditorClick" Width="22" Height="22" FontSize="11"
                                    Margin="8,14,0,0">
                                <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Достижения проекта: src/main/resources/data/&lt;mod&gt;/advancements"
                                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="14,0,8,4"/>
                        <ListBox x:Name="AdvancementsList" Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="8,0"
                                 MouseDoubleClick="OnAdvancementListDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Text="🏆 " Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource ForegroundBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- Performance -->
                    <Grid x:Name="PN_Performance" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Grid.Row="1" Margin="14,4">
                            <TextBlock Text="{Binding PerfCpuLabel}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
                            <ProgressBar Value="{Binding PerfCpu, Mode=OneWay}" Maximum="100" Margin="0,0,0,6" Foreground="{DynamicResource MinecraftGreenBrush}"/>
                            <TextBlock Text="{Binding PerfMemLabel}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,4"/>
                            <ProgressBar Value="{Binding PerfMemPct, Mode=OneWay}" Maximum="100" Margin="0,0,0,6" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="GPU: — (метрики не собираются)" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4"/>
                            <TextBlock Text="FPS: — (нужен запущенный клиент)" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4"/>
                            <TextBlock Text="Запустите Run — CPU и память Java-процесса будут собираться здесь в реальном времени."
                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Extensions -->
                    <Grid x:Name="PN_Extensions" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="EXTENSIONS" Style="{StaticResource SectionHeader}"/>
                        <StackPanel Grid.Row="1" Margin="14,4">
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Stretch" Padding="10,8" Margin="0,2">
                                <StackPanel>
                                    <TextBlock Text="Forge Snippets" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Code templates for Forge" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Stretch" Padding="10,8" Margin="0,2">
                                <StackPanel>
                                    <TextBlock Text="Mixin Helper" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Auto-generated Mixin configs" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Stretch" Padding="10,8" Margin="0,2">
                                <StackPanel>
                                    <TextBlock Text="JSON Schema" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Inline validation for .json" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Stretch" Padding="10,8" Margin="0,2">
                                <StackPanel>
                                    <TextBlock Text="Datagen Toolkit" Foreground="{DynamicResource ForegroundBrush}"/>
                                    <TextBlock Text="Generate assets and data" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>

            <!-- Splitter: тянуть за край, чтобы изменить ширину боковой панели -->
            <GridSplitter Grid.Column="2" Width="4" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"/>

            <!-- Editor / Right dock -->
            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition x:Name="RightDockColumn" Width="320" MinWidth="200"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Breadcrumbs -->
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>  <!-- Splitter -->
                    <RowDefinition x:Name="TerminalRow" Height="220" MinHeight="0"/>  <!-- Terminal panel -->
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgbgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,3">
                    <StackPanel Orientation="Horizontal" Margin="20,0">
                        <TextBlock Text="…" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedProject.Name}" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="›" Foreground="{DynamicResource ForegroundDimBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveTab.Title}" Foreground="{DynamicResource ForegroundMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                    <!-- Editor area -->
                    <TabControl x:Name="EditorTabs" Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Tabs}" SelectedItem="{Binding ActiveTab}"
                                Background="{DynamicResource BgbgBrush}"
                                BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem" BasedOn="{StaticResource EditorTabItem}"/>
                        </TabControl.Resources>
                        <TabControl.ContentTemplate>
                            <DataTemplate>
                                <Grid Background="{DynamicResource BgbgBrush}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <ctrl:SharpCodeEditor Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Language="{Binding Language}"
                                                              Margin="0,0,0,0"/>
                                    </ScrollViewer>
                                </Grid>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>

                    <!-- Splitter: тянуть за край, чтобы изменить ширину правого дока (на всю высоту) -->
                    <GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="4" Width="4" ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  Background="{DynamicResource BorderBrush}"
                                  DragCompleted="OnRightDockSplitterDragCompleted"/>

                    <!-- Right dock panels (Properties / Preview) — на всю высоту окна -->
                    <Border x:Name="RightDock" Grid.Column="2" Grid.Row="0" Grid.RowSpan="4"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="8,8">
                                <ToggleButton x:Name="RD_Recipes" Style="{StaticResource ActivityBtn}" Width="30" Height="24" FontSize="11" Tag="Редактор рецептов" Click="OnRightPanelClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol">
                                    <TextBlock Text="&#xE8A5;"/>
                                </ToggleButton>
                                <ToggleButton x:Name="RD_Advancements" Style="{StaticResource ActivityBtn}" Width="30" Height="24" FontSize="11" Tag="Конструктор достижений" Click="OnRightPanelClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol">
                                    <TextBlock Text="&#xE7C1;"/>
                                </ToggleButton>
                                <ToggleButton x:Name="RD_Properties" Style="{StaticResource ActivityBtn}" Width="30" Height="24" FontSize="11" IsChecked="True" Click="OnRightPanelClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol">
                                    <TextBlock Text="&#xE90F;"/>
                                </ToggleButton>
                                <ToggleButton x:Name="RD_Model" Style="{StaticResource ActivityBtn}" Width="30" Height="24" FontSize="11" Click="OnRightPanelClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol">
                                    <TextBlock Text="&#xE8B7;"/>
                                </ToggleButton>
                                <ToggleButton x:Name="RD_Texture" Style="{StaticResource ActivityBtn}" Width="30" Height="24" FontSize="11" Click="OnRightPanelClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol">
                                    <TextBlock Text="&#xE8B9;"/>
                                </ToggleButton>
                                <ToggleButton x:Name="RD_JSON" Style="{StaticResource ActivityBtn}" Width="30" Height="24" FontSize="11" Click="OnRightPanelClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol">
                                    <TextBlock Text="&#xE93C;"/>
                                </ToggleButton>
                                <ToggleButton x:Name="RD_ModelEditor" Style="{StaticResource ActivityBtn}" Width="30" Height="24" FontSize="11" Tag="Редактор моделей (Blockbench)" Click="OnRightPanelClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol">
                                    <TextBlock Text="&#xE8B7;"/>
                                </ToggleButton>
                                <ToggleButton x:Name="RD_QuickAccess" Style="{StaticResource ActivityBtn}" Width="30" Height="24" FontSize="11" Tag="Быстрый доступ" Click="OnRightPanelClick" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol">
                                    <TextBlock Text="&#xE8F1;"/>
                                </ToggleButton>
                            </StackPanel>

                            <!-- Recipes (visual recipe editor) -->
                            <Grid x:Name="RD_PN_Recipes" Grid.Row="1" Visibility="Collapsed">
                                <recipe:RecipeEditorControl x:Name="RecipeEditorHost"/>
                            </Grid>

                            <!-- Advancements (visual advancement builder) -->
                            <Grid x:Name="RD_PN_Advancements" Grid.Row="1" Visibility="Collapsed">
                                <adv:AdvancementEditorControl x:Name="AdvancementEditorHost"/>
                            </Grid>

                            <!-- Blockbench model editor (embedded WebView2) -->
                            <Grid x:Name="RD_PN_ModelEditor" Grid.Row="1" Visibility="Collapsed">
                                <Grid>
                                    <wv2:WebView2 x:Name="ModelEditorWeb"/>
                                    <Border x:Name="ModelEditorLoading" Background="#FF1E1E1E">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                            <TextBlock Text="Загрузка редактора моделей…"
                                                       Foreground="{DynamicResource ForegroundBrush}" FontSize="13"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Blockbench" Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"
                                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock x:Name="ModelEditorError" Text="" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ErrorBrush}" FontSize="11"
                                                       HorizontalAlignment="Center" TextAlignment="Center"
                                                       Margin="0,14,0,0" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Properties -->
                            <Grid x:Name="RD_PN_Properties" Grid.Row="1" Visibility="Visible" Margin="14,4">
                                <StackPanel>
                                    <TextBlock Text="PROPERTIES" Style="{StaticResource SectionHeader}" Margin="0,2"/>
                                    <Grid Margin="0,6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="File" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="0" Margin="0,4"/>
                                        <TextBlock Text="{Binding ActiveTab.FullPath}"
                                                   Foreground="{DynamicResource ForegroundBrush}" Grid.Row="0" Grid.Column="1"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4"/>
                                        <TextBlock Text="Language" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="1" Margin="0,4"/>
                                        <TextBlock Text="{Binding ActiveTab.Language}" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="Lines" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="2" Margin="0,4"/>
                                        <TextBlock x:Name="LineCountText" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="Modified" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="3" Margin="0,4"/>
                                        <TextBlock Text="—" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="Encoding" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="4" Margin="0,4"/>
                                        <TextBlock Text="UTF-8" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="EOL" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="5" Margin="0,4"/>
                                        <TextBlock Text="LF" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="Indent" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="6" Margin="0,4"/>
                                        <TextBlock Text="Spaces: 4" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="6" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="Project" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="7" Margin="0,4"/>
                                        <TextBlock Text="{Binding SelectedProject.Name}" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="7" Grid.Column="1" Margin="0,4"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Model preview -->
                            <Grid x:Name="RD_PN_Model" Grid.Row="1" Visibility="Collapsed" Margin="14,4">
                                <StackPanel>
                                    <TextBlock Text="MODEL PREVIEW" Style="{StaticResource SectionHeader}" Margin="0,2"/>
                                    <Border Background="{DynamicResource BgbgLightBrush}" CornerRadius="4" Padding="0" Height="220" Margin="0,8">
                                        <Grid>
                                            <TextBlock Text="🐎" FontSize="80" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.3"/>
                                            <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6">
                                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="11">
                                                            <TextBlock Text="&#xE8A4;" FontFamily="Segoe MDL2 Assets"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="11">
                                                            <TextBlock Text="&#xE8A3;" FontFamily="Segoe MDL2 Assets"/>
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="11">
                                                            <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text=".jsonmodel • cube_all" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Format" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4"/>
                                        <TextBlock Text="1.20.4 (modern)" Foreground="{DynamicResource ForegroundBrush}" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="Textures" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="1" Margin="0,4"/>
                                        <TextBlock Text="2 culled" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Texture preview (shows the image of the opened file) -->
                            <Grid x:Name="RD_PN_Texture" Grid.Row="1" Visibility="Collapsed" Margin="14,4">
                                <StackPanel>
                                    <TextBlock Text="TEXTURE PREVIEW" Style="{StaticResource SectionHeader}" Margin="0,2"/>
                                    <Border Background="{DynamicResource BgbgLightBrush}" CornerRadius="4" Height="220" Margin="0,8"
                                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                                        <Grid>
                                            <Image x:Name="RD_TextureImage" Stretch="Uniform" Margin="8" Visibility="Collapsed"/>
                                            <TextBlock x:Name="RD_TextureHint"
                                                       Text="Откройте .png файл в Explorer, чтобы увидеть его здесь"
                                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"
                                                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Margin="12"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="RD_TextureCaption" Text="—" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Size" Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4"/>
                                        <TextBlock x:Name="RD_TextureSize" Text="—" Foreground="{DynamicResource ForegroundBrush}" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="Format" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="1" Margin="0,4"/>
                                        <TextBlock x:Name="RD_TextureFormat" Text="—" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                                        <TextBlock Text="File" Foreground="{DynamicResource ForegroundMutedBrush}" Grid.Row="2" Margin="0,4"/>
                                        <TextBlock x:Name="RD_TextureFile" Text="—" Foreground="{DynamicResource ForegroundBrush}" Grid.Row="2" Grid.Column="1" Margin="0,4" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- JSON (formats the opened .json file) -->
                            <Grid x:Name="RD_PN_JSON" Grid.Row="1" Visibility="Collapsed" Margin="14,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="JSON VIEWER" Style="{StaticResource SectionHeader}" Margin="0,2"/>
                                    <TextBlock x:Name="RD_JSONCaption" Text="Откройте .json файл — он будет отформатирован здесь"
                                               Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11" Margin="0,2"/>
                                </StackPanel>
                                <Border Grid.Row="1" Background="{DynamicResource BgbgLightBrush}" BorderBrush="{DynamicResource BorderLightBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="RD_JSONText" FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                                   Foreground="{DynamicResource ForegroundBrush}" TextWrapping="NoWrap"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- Quick access: items / images / models -->
                            <Grid x:Name="RD_PN_QuickAccess" Grid.Row="1" Visibility="Collapsed" Margin="14,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="БЫСТРЫЙ ДОСТУП" Style="{StaticResource SectionHeader}" Margin="0,2"/>
                                <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
                                            <Setter Property="Padding" Value="10,5"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TabItem">
                                                        <Border x:Name="Bd" Background="Transparent"
                                                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighlightBrush}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TabControl.Resources>
                                    <TabItem Header="Предметы">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBox x:Name="QAItemSearch" Style="{StaticResource ModernTextBox}" Margin="0,4"
                                                     ToolTip="Поиск предмета; клик — скопировать id"
                                                     KeyDown="OnQAItemSearchKeyDown"/>
                                            <TextBlock x:Name="QAItemHint" Grid.Row="1"
                                                       Text="Клиент Minecraft не найден (.minecraft/versions) — список предметов недоступен."
                                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Margin="2,6" Visibility="Collapsed"/>
                                            <ListBox x:Name="QAItems" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                                     PreviewMouseLeftButtonUp="OnQAItemClick"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                                            <Image Source="{Binding ., Converter={StaticResource ItemIcon}}"
                                                                   Width="20" Height="20" Margin="0,0,8,0" Stretch="Uniform"
                                                                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource ForegroundBrush}"
                                                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="4,2"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Изображения">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="QAImageHint" Grid.Row="1"
                                                       Text="Нет изображений в проекте (PNG/JPG)."
                                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Margin="2,6" Visibility="Collapsed"/>
                                            <ListBox x:Name="QAImages" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                                     MouseDoubleClick="OnQAImageDoubleClick"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <Border Background="{DynamicResource BgbgLightBrush}"
                                                                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                                                                    Width="40" Height="40" Margin="0,0,8,0">
                                                                <Image Source="{Binding FullPath}" Width="36" Height="36" Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                            </Border>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FullPath}" Foreground="{DynamicResource ForegroundDimBrush}"
                                                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="4,2"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Модели">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="QAModelHint" Grid.Row="1"
                                                       Text="Нет файлов моделей (assets/*/models/*.json)."
                                                       Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"
                                                       Margin="2,6" Visibility="Collapsed"/>
                                            <ListBox x:Name="QAModels" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                                     MouseDoubleClick="OnQAModelDoubleClick"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                                            <TextBlock Text="📦 " FontSize="14" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource ForegroundBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FullPath}" Foreground="{DynamicResource ForegroundDimBrush}"
                                                                           FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="4,2"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Grid>
                    </Border>

                <!-- Splitter: тянуть за край, чтобы изменить высоту терминала -->
                <GridSplitter Grid.Row="2" Grid.Column="0" Height="4" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="{DynamicResource BorderBrush}"/>

                <!-- Terminal Panel -->
                <Border x:Name="TerminalPanel" Grid.Row="3" Grid.Column="0" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Background="{DynamicResource BgbgLightBrush}">
                            <ToggleButton x:Name="TP_Console" Style="{StaticResource ActivityBtn}" Width="Auto" Height="26" FontSize="11" IsChecked="True" Padding="12,0" Click="OnTerminalTabClick">
                                <TextBlock Text="Console"/>
                            </ToggleButton>
                            <ToggleButton x:Name="TP_Build" Style="{StaticResource ActivityBtn}" Width="Auto" Height="26" FontSize="11" Padding="12,0" Click="OnTerminalTabClick">
                                <TextBlock>
                                    <Run Text="Build"/>
                                    <Run Foreground="{DynamicResource ErrorBrush}" Text=" ●"/>
                                </TextBlock>
                            </ToggleButton>
                            <ToggleButton x:Name="TP_Problems" Style="{StaticResource ActivityBtn}" Width="Auto" Height="26" FontSize="11" Padding="12,0" Click="OnTerminalTabClick">
                                <TextBlock>
                                    <Run Text="Problems"/>
                                    <Run Foreground="{DynamicResource ErrorBrush}" Text=" ●"/>
                                </TextBlock>
                            </ToggleButton>
                            <ToggleButton x:Name="TP_Logs" Style="{StaticResource ActivityBtn}" Width="Auto" Height="26" FontSize="11" Padding="12,0" Click="OnTerminalTabClick">
                                <TextBlock Text="Logs"/>
                            </ToggleButton>
                            <ToggleButton x:Name="TP_Gradle" Style="{StaticResource ActivityBtn}" Width="Auto" Height="26" FontSize="11" Padding="12,0" Click="OnTerminalTabClick">
                                <TextBlock Text="Gradle"/>
                            </ToggleButton>
                            <ToggleButton x:Name="TP_Crash" Style="{StaticResource ActivityBtn}" Width="Auto" Height="26" FontSize="11" Padding="12,0" Click="OnTerminalTabClick">
                                <TextBlock>
                                    <Run Text="Crash Reports"/>
                                </TextBlock>
                            </ToggleButton>
                            <Border Width="1" Background="{DynamicResource BorderLightBrush}" Margin="0,4"/>
                            <Button Style="{StaticResource IconButton}" ToolTip="Split terminal" Width="24" Height="24" FontSize="11">
                                <TextBlock Text="&#xE8A0;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Clear" Width="24" Height="24" FontSize="11" Click="OnClearTerminal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Свернуть панель" Click="OnToggleTerminal" Width="24" Height="24" FontSize="11">
                                <TextBlock x:Name="TerminalToggleIcon" Text="&#xE921;" FontFamily="Segoe MDL2 Assets"/>
                            </Button>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <!-- Console -->
                            <ScrollViewer x:Name="TP_ConsoleView" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ConsoleLogs}" Margin="14,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource ForegroundDimBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LevelLabel}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="{DynamicResource ForegroundMutedBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11" TextWrapping="NoWrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Build -->
                            <ScrollViewer x:Name="TP_BuildView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="14,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding BuildStatus.PhaseLabel}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}"/>
                                        <TextBlock Text="—" Foreground="{DynamicResource ForegroundDimBrush}" Margin="6,0"/>
                                        <TextBlock Text="{Binding BuildStatus.Message}" Foreground="{DynamicResource ForegroundMutedBrush}"/>
                                    </StackPanel>
                                    <ProgressBar Grid.Row="1" Value="{Binding BuildStatus.Progress}" Maximum="100" Margin="0,4"/>
                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding BuildLogs}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource ForegroundDimBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding LevelLabel}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="{DynamicResource ForegroundMutedBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>

                            <!-- Problems -->
                            <ScrollViewer x:Name="TP_ProblemsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <Grid Margin="14,4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Errors: " Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ErrorCount}" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" Margin="0,4"/>
                                        <TextBlock Text="   Warnings: " Foreground="{DynamicResource ForegroundMutedBrush}" Margin="0,4"/>
                                        <TextBlock Text="{Binding WarningCount}" Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" Margin="0,4"/>
                                    </StackPanel>
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Problems}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                               Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{DynamicResource ForegroundMutedBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding LevelLabel}" Foreground="{DynamicResource ErrorBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource ForegroundBrush}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </ScrollViewer>

                            <!-- Logs -->
                            <ScrollViewer x:Name="TP_LogsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding MinecraftLogs}" Margin="14,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource ForegroundDimBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LevelLabel}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="{DynamicResource MinecraftGreenBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Gradle -->
                            <ScrollViewer x:Name="TP_GradleView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding GradleLogs}" Margin="14,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="60"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource ForegroundDimBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LevelLabel}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="{DynamicResource ForegroundMutedBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{DynamicResource ForegroundBrush}" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Crash Reports -->
                            <Grid x:Name="TP_CrashView" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Margin="14,8">
                                    <Button Style="{StaticResource FlatButton}" Padding="8,4" Click="OnCrashRefreshClick">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Refresh"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding CrashReports}" Margin="14,4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgbgLightBrush}" CornerRadius="4" Padding="10" Margin="0,4">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="💥 " FontSize="14"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Time, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                               Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" Margin="0,2"/>
                                                    <TextBlock Text="{Binding Suggestions}" Foreground="{DynamicResource ForegroundMutedBrush}"
                                                               FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ============== STATUS BAR (footer) ============== -->
        <Border Grid.Row="2" Background="{DynamicResource StatusBarBrush}" Height="22">
            <Grid Margin="10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="⌬ main" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock Text="↻ Sync" Foreground="White" FontSize="11" Margin="0,0,12,0" Cursor="Hand"/>
                    <TextBlock x:Name="ErrorsBadge" Text="0" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="errors" Foreground="White" FontSize="11" Margin="0,0,12,0"/>
                    <TextBlock x:Name="WarningsBadge" Text="0" Foreground="White" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="warnings" Foreground="White" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="⛏ " Foreground="White" VerticalAlignment="Center" FontSize="11"/>
                    <TextBlock Text="{Binding SelectedProject.MinecraftVersion, StringFormat=MC {0}, TargetNullValue=''}" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock Text="{Binding SelectedProject.ForgeVersion, StringFormat=🔥 Forge {0}, TargetNullValue=''}" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock x:Name="StatusBuildLabel" Text="Build: Готов" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock x:Name="StatusLauncherLabel" Text="" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock x:Name="StatusLnCol" Text="Ln 1, Col 1" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock Text="Spaces: 4" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock Text="UTF-8" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock Text="LF" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock Text="Java 17" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock Text=".NET 8" Foreground="White" FontSize="11" Margin="0,0,14,0"/>
                    <TextBlock x:Name="StatusThemeLabel" Text="Dark theme" Foreground="White" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
