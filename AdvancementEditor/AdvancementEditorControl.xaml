<UserControl x:Class="MineIDE.AdvancementEditor.AdvancementEditorControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MineIDE.AdvancementEditor"
        xmlns:models="clr-namespace:MineIDE.AdvancementEditor.Models"
        xmlns:vm="clr-namespace:MineIDE.AdvancementEditor.ViewModels"
        Background="{DynamicResource BgbgBrush}">

    <UserControl.Resources>
        <local:AdvItemIconConverter x:Key="ItemIcon"/>
        <local:AdvFrameConverter x:Key="FrameIcon"/>

        <Style x:Key="AdvSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="AdvFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,5,0,2"/>
        </Style>

        <!-- One advancement node: in-game frame + item icon + title -->
        <DataTemplate x:Key="AdvNodeTemplate" DataType="{x:Type models:AdvancementModel}">
            <Grid Width="64" Height="84" AllowDrop="True" DragOver="OnNodeDragOver" Drop="OnNodeDrop"
                  MouseLeftButtonDown="OnNodeMouseDown" MouseMove="OnNodeMouseMove" MouseLeftButtonUp="OnNodeMouseUp"
                  MouseRightButtonUp="OnNodeRightClick" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid Width="52" Height="52">
                        <!-- In-game frame (2x: 26x26 -> 52x52) -->
                        <Image Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource FrameIcon}">
                                    <Binding Path="Frame"/>
                                    <Binding Path="IsSelected"/>
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <!-- Item icon (16x16 -> 32x32) -->
                        <Image Source="{Binding IconItem, Converter={StaticResource ItemIcon}}"
                               Width="32" Height="32" Stretch="Uniform" IsHitTestVisible="False"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Grid>
                    <TextBlock Text="{Binding DisplayName}" FontSize="8" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="62" TextWrapping="Wrap"
                               Foreground="{DynamicResource ForegroundBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============== TOOLBAR ============== -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:Loc.EditorTitle}" Style="{StaticResource AdvSectionTitle}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Style="{StaticResource FlatButton}" Click="OnNewClick" Padding="8,4" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static local:Loc.NewBtn}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="OnOpenClick" Padding="8,4" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Открыть" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="OnSaveClick" Padding="8,4" Margin="0,0,2,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static local:Loc.SaveBtn}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource FlatButton}" Click="OnDeleteClick" Padding="8,4" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Static local:Loc.DeleteBtn}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{DynamicResource BorderLightBrush}" Margin="0,4,10,4"/>

                <TextBlock Text="{x:Static local:Loc.BackgroundLabel}" VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11" Margin="0,0,6,0"/>
                <ComboBox Style="{StaticResource ModernComboBox}" Width="140" Margin="0,0,4,0"
                          ItemsSource="{Binding BackgroundOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Key" SelectedValue="{Binding BackgroundName}"
                          ToolTip="{x:Static local:Loc.BackgroundHint}"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding StatusText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11"/>
        </Grid>

        <!-- ============== CONTENT ============== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- ==== LEFT: tree canvas (free placement) + hint + JSON + palette ==== -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tree canvas -->
                <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Canvas x:Name="TreeCanvas" Width="1400" Height="900"
                                Background="{DynamicResource BgbgBrush}"
                                AllowDrop="True" DragOver="OnCanvasDragOver" Drop="OnCanvasDrop"
                                MouseRightButtonUp="OnCanvasRightClick">
                            <Canvas x:Name="LinesCanvas" Width="1400" Height="900" IsHitTestVisible="False"/>
                            <ItemsControl ItemsSource="{Binding Document.Nodes}"
                                          ItemTemplate="{StaticResource AdvNodeTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding DisplayX}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding DisplayY}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="1" Text="{x:Static local:Loc.CanvasHint}"
                           Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,8" MaxWidth="560" HorizontalAlignment="Left"/>

                <!-- JSON preview -->
                <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="{x:Static local:Loc.JsonLabel}" Style="{StaticResource AdvSectionTitle}"
                                       VerticalAlignment="Center"/>
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                                    ToolTip="{x:Static local:Loc.CopyJson}" Click="OnCopyJsonClick" Width="24" Height="22">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource ErrorBrush}" CornerRadius="3" Padding="8,6"
                                Margin="0,0,0,6" Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="{x:Static local:Loc.ErrorsTitle}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                <TextBlock Text="{Binding ErrorText}" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource BgbgBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="4">
                            <TextBox Text="{Binding JsonText, Mode=OneWay}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource SyntaxMethodBrush}"
                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                     IsReadOnly="True" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Padding="8" AcceptsReturn="True" AcceptsTab="True" Height="110"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Item palette (drag onto empty canvas to create a node, onto a node to set its icon) -->
                <Grid Grid.Row="3" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,4">
                        <TextBlock Text="{x:Static local:Loc.ItemsLabel}" Style="{StaticResource AdvSectionTitle}"
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="ItemFilter" Style="{StaticResource ModernTextBox}"
                                 HorizontalAlignment="Right" Width="200" ToolTip="Поиск предмета (item id)"
                                 TextChanged="OnItemFilterChanged"/>
                    </Grid>
                    <ListBox x:Name="ItemList" Grid.Row="1"
                             ItemsSource="{Binding Resources}"
                             Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                             Foreground="{DynamicResource ForegroundBrush}"
                             PreviewMouseLeftButtonDown="OnItemMouseDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             MaxHeight="120">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="{Binding ., Converter={StaticResource ItemIcon}}"
                                           Width="18" Height="18" Margin="0,0,8,0"
                                           VerticalAlignment="Center" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource ForegroundBrush}"
                                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- ==== RIGHT: selected node properties ==== -->
            <Border Grid.Column="1" Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{x:Static local:Loc.NoModel}"
                                   Foreground="{DynamicResource ForegroundDimBrush}" FontSize="11" TextWrapping="Wrap"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInv}}"/>

                        <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static local:Loc.ModelProperties}" Style="{StaticResource AdvSectionTitle}"/>

                            <TextBlock Text="{x:Static local:Loc.IdLabel}" Style="{StaticResource AdvFieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SelectedModel.Id, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="get_paraglider — уникальный ID, также имя файла"/>

                            <TextBlock Text="{x:Static local:Loc.TitleLabel}" Style="{StaticResource AdvFieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding SelectedModel.Title, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{x:Static local:Loc.DescriptionLabel}" Style="{StaticResource AdvFieldLabel}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap" Height="52"
                                     Text="{Binding SelectedModel.Description, UpdateSourceTrigger=PropertyChanged}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{x:Static local:Loc.IconLabel}" Style="{StaticResource AdvFieldLabel}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding SelectedModel.IconItem, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="minecraft:paraglider"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Превью" Style="{StaticResource AdvFieldLabel}"/>
                                    <Border Width="40" Height="40" CornerRadius="4" Background="{DynamicResource BgbgBrush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                                        <Image Source="{Binding SelectedModel.IconItem, Converter={StaticResource ItemIcon}}"
                                               Width="30" Height="30" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="{x:Static local:Loc.TriggerLabel}" Style="{StaticResource AdvFieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding TriggerOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Trigger" SelectedValue="{Binding SelectedModel.Trigger}"/>

                            <StackPanel Visibility="{Binding SelectedModel.NeedsTriggerItem, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static local:Loc.TriggerItemLabel}" Style="{StaticResource AdvFieldLabel}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SelectedModel.TriggerItem, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="minecraft:paraglider"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedModel.NeedsTriggerEntity, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static local:Loc.TriggerEntityLabel}" Style="{StaticResource AdvFieldLabel}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SelectedModel.TriggerEntity, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="minecraft:zombie"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedModel.NeedsTriggerLevel, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static local:Loc.TriggerLevelLabel}" Style="{StaticResource AdvFieldLabel}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SelectedModel.TriggerLevel, UpdateSourceTrigger=LostFocus}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding SelectedModel.NeedsLootTable, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{x:Static local:Loc.TriggerLootLabel}" Style="{StaticResource AdvFieldLabel}"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SelectedModel.TriggerLootTable, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="minecraft:chests/simple_dungeon"/>
                            </StackPanel>

                            <TextBlock Text="{x:Static local:Loc.ParentLabel}" Style="{StaticResource AdvFieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding ParentOptions}" DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Id" SelectedValue="{Binding SelectedModel.ParentId}"/>

                            <TextBlock Text="{x:Static local:Loc.FrameLabel}" Style="{StaticResource AdvFieldLabel}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding FrameOptions}" DisplayMemberPath="Label"
                                      SelectedValuePath="Frame" SelectedValue="{Binding SelectedModel.Frame}"/>

                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="{x:Static local:Loc.ShowToast}"
                                          IsChecked="{Binding SelectedModel.ShowToast}" Margin="0,0,12,0"/>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="{x:Static local:Loc.AnnounceChat}"
                                          IsChecked="{Binding SelectedModel.AnnounceToChat}" Margin="0,0,12,0"/>
                                <CheckBox Style="{StaticResource ModernCheckBox}" Content="{x:Static local:Loc.Hidden}"
                                          IsChecked="{Binding SelectedModel.Hidden}"/>
                            </WrapPanel>

                            <Border Background="{DynamicResource BgbgBrush}" CornerRadius="4" Padding="8" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{x:Static local:Loc.RewardLabel}" Style="{StaticResource AdvSectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Static local:Loc.RewardExp}"
                                                   Style="{StaticResource AdvFieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Width="70" Margin="0,0,12,0"
                                                 Text="{Binding SelectedModel.RewardExperience, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Static local:Loc.RewardItem}"
                                                   Style="{StaticResource AdvFieldLabel}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="3" Style="{StaticResource ModernTextBox}"
                                                 Text="{Binding SelectedModel.RewardItem, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="minecraft:elytra"/>
                                    </Grid>
                                    <TextBlock Text="{x:Static local:Loc.RewardCount}" Style="{StaticResource AdvFieldLabel}"/>
                                    <TextBox Style="{StaticResource ModernTextBox}" Width="70" HorizontalAlignment="Left"
                                             Text="{Binding SelectedModel.RewardItemCount, UpdateSourceTrigger=LostFocus}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
